# Multimodal Vision Model Engine Configuration
# Supported providers: "openrouter", "gemini", "groq"
API_PROVIDER=openrouter

# Your API Key (leave empty to use precomputed test set or configure via Web UI)
API_KEY=

# Base URL (OpenAI-compatible)
BASE_URL=https://openrouter.ai/api/v1

# Multimodal Model Name (must support image inputs)
# Recommended free router: openrouter/free
# Recommended direct Gemini: gemini-2.0-flash
MODEL_NAME=openrouter/free
